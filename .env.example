# Copy this file to ".env" and fill in your key.
# The .env file is ignored by git and must never be shared or submitted.

# Your Groq API key (required). Free, no card: https://console.groq.com/keys
GROQ_API_KEY=

# These already match Groq. Only change them if you switch to a different
# provider or model.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Port for the local web interface.
PORT=8000
