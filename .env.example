# Copy this file to ".env" and fill in your key.
# The .env file is ignored by git and must never be shared or submitted.

# Your AtlasCloud API key (required)
ATLASCLOUD_API_KEY=

# These already match the AtlasCloud endpoint. Only change them if you switch
# to a different provider.
ATLASCLOUD_BASE_URL=https://api.atlascloud.ai/v1
ATLASCLOUD_MODEL=deepseek-ai/deepseek-v4-flash

# Port for the local web interface.
PORT=8000
