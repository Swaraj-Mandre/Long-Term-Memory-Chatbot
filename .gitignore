# Secrets - never commit the real key
.env

# Virtual environment
.venv/

# The saved memory database (regenerated by running the app)
memory_data/

# Python cache files
__pycache__/
*.pyc

# Evaluation output
evaluation/results/

# Node modules for the slide generator
node_modules/

# Rendered slide images, regenerated from the .pptx
presentation/preview/

# Evaluation scratch database, recreated on every run
evaluation/_eval_db/

# Editor and OS noise
*.bak
.DS_Store
Thumbs.db
