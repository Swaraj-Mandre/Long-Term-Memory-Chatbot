# Secrets - never commit the real key
.env

# Virtual environment
.venv/

# The saved memory database (regenerated by running the app)
memory_data/

# Python cache files
__pycache__/
*.pyc

# Evaluation output and scratch database
evaluation/results/
evaluation/_eval_db/

# Node modules for the slide generator
node_modules/

# Slide decks, PDFs and team documents stay local. Slide 1 of each deck lists
# the team's emails and phone numbers, which should not be public.
*.pptx
*.pdf
*.docx
docs/team/

# Local editor and preview settings
.claude/

# Editor and OS noise
*.bak
.DS_Store
Thumbs.db
